---
import FetchForm from "../components/fetcher";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Album of the year fetcherer">
  <main class="mx-auto min-h-screen max-w-4xl px-4 pb-16">
    <h1 class="mx-auto mt-16 mb-8 max-w-4xl border-b border-palette-line pb-6 text-center font-serif text-4xl font-medium text-palette-paper">
      Album Fetchererer
    </h1>
    <FetchForm client:only="react" />
  </main>
</Layout>
<style is:global>
  td {
    max-width: 200px;

    p {
      max-width: 200px;
      text-overflow: ellipsis;
      overflow: hidden;
    }
  }

  ::selection {
    background: var(--palette-paper);
    color: var(--palette-ink);
  }
</style>
